######################################################################
###### Do not edit this file                                    ######
###### To provide paths to libraries edit paths.inc             ######
###### To tune compiling and linking flags edit libs.inc        ######
###### For details see INSTALL                                  ######
######################################################################

default:
	$(MAKE) -C ./real
	$(MAKE) -C ./complex
	$(MAKE) -C ./threads
	$(MAKE) -C ./KLink
	$(MAKE) -C ./sourcesTools

gpu:
	$(MAKE) -C ./realG
	$(MAKE) -C ./complexG

.PHONY: all
all: default
	$(MAKE) -C ./mpi

.PHONY: mpi
mpi:
	$(MAKE) -C ./mpi

nomath: noklink

.PHONY: noklink
noklink:
	$(MAKE) -C ./real
	$(MAKE) -C ./complex
	$(MAKE) -C ./threads
	$(MAKE) -C ./sourcesTools

clean:
	rm -f ./real/*.o
	rm -f ./complex/*.o
	rm -f ./realG/*.o
	rm -f ./complexG/*.o
	rm -f ./threads/*.o
	rm -f ./mpi/*.o
	rm -f ./KLink/*.o
	rm -f ./KLink/MathSide.c
	rm -f ./sourcesTools/OutputIntegrand.o

.PHONY: cleanbin
cleanbin: 
	rm -f ./KLink/KLink
	rm -f ./real/CIntegrateMP
	rm -f ./complex/CIntegrateMPC
	rm -f ./realG/CIntegrateMPG
	rm -f ./complexG/CIntegrateMPCG
	rm -f ./threads/CIntegratePool
	rm -f ./mpi/CIntegratePoolMPI
	rm -f ./sourcesTools/OutputIntegrand
.PHONY: cleantemp
cleantemp:
	rm -f temp/*


.PHONY: cleanbak
cleanbak:
	rm -f ./*~
	rm -f ./*.backup
	rm -f ./*.bak
	rm -f ./sources/*~
	rm -f ./sources/*.backup
	rm -f ./sources/*.bak
	rm -f ./sourcesTools/*~
	rm -f ./sourcesTools/*.backup
	rm -f ./sourcesTools/*.bak
	rm -f ./sourcesPool/*~
	rm -f ./sourcesPool/*.backup
	rm -f ./sourcesPool/*.bak
	rm -f ./KLink/*~
	rm -f ./KLink/*.backup
	rm -f ./KLink/*.bak
	rm -f examples/out.kch
	rm -f real/*.bak
	rm -f real/*.backup
	rm -f realG/*.bak
	rm -f realG/*.backup
	rm -f complex/*.bak
	rm -f complexG/*.backup
	rm -f mpi/*.bak
	rm -f mpi/*.backup
	rm -f threads/*.bak
	rm -f threads/*.backup
	rm -f extra/*~

.PHONY: cleanall
cleanall: clean cleanbin cleanbak cleantemp

dep: depend

depend:
	cd extra/Cuba-4.0/ && ./configure --prefix=`pwd`/../../usr/
	$(MAKE) -C ./extra/Cuba-4.0 lib
	$(MAKE) -C ./extra/Cuba-4.0 install
	$(MAKE) -C ./extra/Cuba-4.0 lib
	$(MAKE) -C ./extra/Cuba-4.0 install
	cd extra/kyotocabinet-1.2.76/ && ./configure --prefix=`pwd`/../../usr/
	$(MAKE) -C ./extra/kyotocabinet-1.2.76
	$(MAKE) -C ./extra/kyotocabinet-1.2.76 install

uuid:
	cd extra/libuuid-1.0.3/ && ./configure --prefix=`pwd`/../../usr/
	$(MAKE) -C ./extra/libuuid-1.0.3
	$(MAKE) -C ./extra/libuuid-1.0.3 install


cleandep:
	if [ -f extra/Cuba-4.0/makefile ]; then $(MAKE) -C ./extra/Cuba-4.0 distclean; fi;
	if [ -f extra/kyotocabinet-1.2.76/Makefile ]; then $(MAKE) -C ./extra/kyotocabinet-1.2.76 distclean; fi;
	if [ -f extra/libuuid-1.0.3/Makefile ]; then $(MAKE) -C ./extra/libuuid-1.0.3 distclean; fi;
	rm -rf usr/include/*
	rm -rf usr/lib/*
	rm -rf usr/share/*
	rm -rf usr/lib64/*
	rm -rf usr/bin/*

.PHONY: test
test:
	echo 'Exit' | bin/CIntegrateMP
	echo 'Exit' | bin/CIntegrateMPC
	bin/CIntegratePool -test 1>/dev/null
	bin/KLink -test 1>/dev/null

.PHONY: testall
testall: test
	mpirun -n 2 bin/CIntegratePoolMPI -test 1>/dev/null
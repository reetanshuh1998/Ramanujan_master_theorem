# this file is optional
# it allows for parameterscans of the symbols specified
# in the parameter file.
#
paramfile=param.input
pointname=p
#---------------------------------------------------------
# a list of parameter values to be calculated, e.g.
#
# .5,.6,.7
# 0.34,26.1,3
# 3.14,6,5
##########################################################
# one can specify lines<number of inputs listed
#
# lines=2
##########################################################
# here one can specify the minimum and maximum values, and
# the size of the increment, for each parameter 
#
# minvals=0.05,3,1
# maxvals=0.55,4,2
# stepvals=0.25,.5,1
##########################################################
# if a non-standard increment is prefered, you can give
# a list of values each parameter should take, and each
# possible combination will be calculated. The number of
# lines should match the number of parameters in the
# integration. eg below we have 3 parameters
#
# values1=1,2,4,8
# values2=.25,.88,1
# values3=3.2
##########################################################
